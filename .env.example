# OpsPilot Environment Configuration
PROJECT_NAME="OpsPilot"
API_V1_STR="/api"
SECRET_KEY="dev_secret_key_change_in_production"

# Database Configuration
DATABASE_URL="sqlite:///./opspilot.db"

# LLM Providers (Optionally set one or both, fallback engine available if neither is provided)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
LLM_PROVIDER="gemini" # 'gemini' or 'openai' or 'mock'
LLM_MODEL="gemini-1.5-flash"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
